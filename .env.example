# --- Required ---

# Get this from @BotFather on Telegram after creating your bot.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# --- Recommended ---

# A long random string. Set the same value when running
# scripts/set-webhook.js — Telegram echoes it back on every webhook
# call so api/bot.js can verify the request actually came from
# Telegram and not some random caller hitting a guessed URL.
TELEGRAM_WEBHOOK_SECRET=choose-a-long-random-string

# --- Optional ---

# If set, POST /api/tiktok requires this exact value in an
# `X-Api-Key` header. Leave unset to keep that endpoint open.
API_ACCESS_KEY=

# Timeouts (milliseconds). Defaults shown.
TIKWM_TIMEOUT_MS=15000
FFPROBE_TIMEOUT_MS=12000

# Set to "false" to skip ffprobe entirely and always omit the
# Technical section (useful if your Vercel plan's function duration
# is too short to reliably probe remote video).
ENABLE_FFPROBE=true

# Basic in-memory rate limiting, per Telegram chat and per API caller IP.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
