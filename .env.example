# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Random secret used to verify that webhook requests really come from
# Telegram (sent back as X-Telegram-Bot-Api-Secret-Token). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Metadata worker (separate FFmpeg/FFprobe service — see /worker)
# ---------------------------------------------------------------------------
# Full URL to the worker's /analyze endpoint
METADATA_WORKER_URL=https://your-ffprobe-worker.example.com/analyze

# Shared secret the Vercel app sends as "Authorization: Bearer <secret>"
# when calling the worker. Must match the worker's METADATA_WORKER_SECRET.
METADATA_WORKER_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Optional: persistent usage logging (Postgres). Leave blank to disable.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Optional: caching / duplicate-request protection backend.
# Works with Vercel KV or any Upstash Redis REST-compatible store.
# Leave blank to fall back to best-effort in-memory caching.
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
CACHE_TTL_SECONDS=600
REQUEST_TIMEOUT_MS=45000
